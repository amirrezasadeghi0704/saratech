# Binary design assets go through Git LFS so the repository stays small and
# clonable. Without this, every save of an 11 MB PcbDoc adds 11 MB to the
# history permanently, because git cannot diff these formats.
*.SLDPRT  filter=lfs diff=lfs merge=lfs -text
*.SLDASM  filter=lfs diff=lfs merge=lfs -text
*.STL     filter=lfs diff=lfs merge=lfs -text
*.STEP    filter=lfs diff=lfs merge=lfs -text
*.PcbDoc  filter=lfs diff=lfs merge=lfs -text
*.SchDoc  filter=lfs diff=lfs merge=lfs -text
*.SchDocPreview filter=lfs diff=lfs merge=lfs -text
*.DXF     filter=lfs diff=lfs merge=lfs -text
*.docx    filter=lfs diff=lfs merge=lfs -text
*.pdf     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.webp    filter=lfs diff=lfs merge=lfs -text

# Arduino sketches stay as plain text so they can be diffed and reviewed.
*.ino text
